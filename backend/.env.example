# Leave DATABASE_URL blank for local SQLite storage.
# For deployment, set this to your hosted PostgreSQL connection string.
# Never commit real database credentials.
DATABASE_URL=

# Set any one (or more) of these. Frontage auto-detects which provider to
# use based on which key is present, in this priority order:
#   Anthropic > OpenAI > Gemini
# Set AI_PROVIDER to force a specific one instead (useful if you have more
# than one key set and want to pick).
#
# Leave all provider keys blank to run with placeholder copy and no AI calls.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI_PROVIDER=anthropic
# AI_PROVIDER=openai
# AI_PROVIDER=gemini

# Optional per-provider model overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.5
# GEMINI_MODEL=gemini-3.7-flash
