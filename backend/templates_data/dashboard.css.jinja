:root {
{% for key, value in vars.items() %}  {{ key }}: {{ value }};
{% endfor %}
  --radius: 14px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 {
  font-family: "Outfit", -apple-system, sans-serif;
  margin: 0;
  font-weight: 600;
}

a { color: inherit; text-decoration: none; }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--color-primary);
  color: var(--color-bg);
  padding: 10px 18px;
  border-radius: 0 0 8px 0;
  z-index: 100;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
}

.skip-link:focus { left: 0; }

a:focus-visible, .dash-nav-item:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.dash-shell {
  display: flex;
  min-height: 100vh;
}

.dash-sidebar {
  width: 240px;
  flex-shrink: 0;
  background: var(--color-surface);
  border-right: 1px solid var(--color-border);
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.dash-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  font-size: 16px;
  padding: 0 6px;
}

.dash-logo {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  object-fit: cover;
}

.dash-logo-fallback {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: var(--color-bg);
}

.dash-logo-fallback svg {
  width: 16px;
  height: 16px;
}

.dash-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.dash-nav-item {
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 14px;
  color: var(--color-text-muted);
}

.dash-nav-item.active {
  background: var(--color-primary);
  color: var(--color-bg);
  font-weight: 600;
}

.dash-nav-item:not(.active):hover {
  background: var(--color-bg);
  color: var(--color-text);
}

.dash-main {
  flex: 1;
  min-width: 0;
}

.dash-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  border-bottom: 1px solid var(--color-border);
}

.dash-search {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 13px;
  color: var(--color-text-muted);
  width: 220px;
}

.dash-topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.demo-badge {
  font-family: "IBM Plex Mono", monospace;
  font-size: 11px;
  letter-spacing: 0.06em;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
}

.dash-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-border);
  flex-shrink: 0;
}

.dash-content {
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.dash-welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 24px 28px;
}

.dash-welcome .eyebrow {
  color: var(--color-primary);
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.dash-welcome h1 {
  font-size: 22px;
  margin: 8px 0 6px;
}

.dash-welcome p {
  color: var(--color-text-muted);
  margin: 0;
  font-size: 14px;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-bg);
  border: none;
  border-radius: 8px;
  padding: 11px 22px;
  font-weight: 600;
  font-size: 14px;
  white-space: nowrap;
  display: inline-block;
}

.dash-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.dash-stat-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dash-stat-label {
  font-size: 13px;
  color: var(--color-text-muted);
}

.dash-stat-value {
  font-size: 26px;
  font-weight: 700;
  font-family: "Outfit", sans-serif;
}

.dash-stat-trend {
  font-size: 12px;
  font-weight: 600;
  width: fit-content;
  padding: 2px 8px;
  border-radius: 999px;
}

.dash-stat-trend.up {
  color: #3fae6a;
  background: rgba(63, 174, 106, 0.12);
}

.dash-stat-trend.down {
  color: #d16060;
  background: rgba(209, 96, 96, 0.12);
}

.dash-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 16px;
}

.dash-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 20px;
}

.dash-panel h3 {
  font-size: 14px;
  margin-bottom: 16px;
  color: var(--color-text-muted);
  font-weight: 600;
}

.dash-chart {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  height: 140px;
}

.dash-bar {
  flex: 1;
  background: var(--color-primary);
  border-radius: 4px 4px 0 0;
  min-height: 4px;
  opacity: 0.85;
}

.dash-activity {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dash-activity li {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-border);
}

.dash-activity li:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dash-activity-time {
  color: var(--color-text-muted);
  font-size: 12px;
  white-space: nowrap;
}

.dash-footnote {
  font-size: 12px;
  color: var(--color-text-muted);
  text-align: center;
  padding-top: 8px;
}

@media (max-width: 860px) {
  .dash-shell { flex-direction: column; }
  .dash-sidebar {
    width: 100%;
    flex-direction: row;
    align-items: center;
    overflow-x: auto;
    padding: 14px 16px;
  }
  .dash-nav { flex-direction: row; }
  .dash-grid { grid-template-columns: 1fr; }
  .dash-search { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
